# Copy the values below into the app's own Secrets editor in Streamlit
# Community Cloud (App -> Settings -> Secrets). Do NOT commit an actual
# secrets.toml file to the repo -- this .example file is safe to commit
# because it has no real values in it, and .gitignore keeps the real one out.

# A GitHub fine-grained personal access token, scoped to ONLY this repository,
# with "Contents" permission set to "Read and write". This is what lets the
# app permanently save uploaded files and KPI results back to GitHub (see
# analysis/git_sync.py and the README's "Connecting persistent storage"
# section for how to create one).
GITHUB_TOKEN = "github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# "your-org-or-username/your-repo-name" -- the same repo this app is
# deployed from.
GITHUB_REPO = "felbry-college/kpi-system"

# Optional -- defaults to "main" if not set.
GITHUB_BRANCH = "main"
